<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 访问后端 API 与视频流 -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 语音对讲（GB28181 前端设备的半双工对讲，见 v0.2.0 设计 §8.1.1）：
         采集麦克风。runtime 权限，首次使用时由系统弹窗申请。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 语音对讲的音频路由（切换听筒/扬声器、控制音量），flutter_webrtc 音频会话需要 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- 更换头像：个人中心允许用户拍照设置头像（2026-10-15 确认保留）。
         注意：实时播放页的「抓图」是截取视频帧，**不需要**本权限 —— 别把它当成
         保留本权限的理由。真正的用途只有「拍照改头像」。
         若日后取消改头像功能，应一并移除此权限与下面的 uses-feature，
         避免应用商店把「有摄像头」当作安装前提。 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- 声明相机为「非必需」，使无摄像头的设备仍可安装（改头像也可从相册选图） -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- ══════════════════════════════════════════════════════════
         IOT 设备接入（v0.3.0）：蓝牙配网 + 扫码
         ══════════════════════════════════════════════════════════ -->

    <!-- Android 12（API 31）起：扫描/连接 BLE 需要运行时权限。
         neverForLocation：声明扫描不用于推导位置，可免去定位权限（系统会忽略
         通过蓝牙推断位置的能力，但我们本来也不使用）。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- Android 11 及以下：BLE 扫描被系统强制要求定位权限，
         且必须声明 ACCESS_FINE_LOCATION（COARSE 在 API 28+ 不够）。
         maxSdkVersion=30 让新系统不再索取该权限。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30"/>

    <!-- 蓝牙为「非必需」：没有 BLE 的设备仍可安装，只是无法使用蓝牙配网 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false"/>

    <application
        android:label="AI Camera"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic：开发/测试环境后端走 http（模拟器 10.0.2.2:8080、
             局域网 IP），Android 9+ 默认禁止明文流量。正式环境切 https 后应移除本属性。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
