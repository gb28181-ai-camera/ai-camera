# ============================================================================
# AI Camera —— Docker Compose 环境变量模板
#
# 用法：
#   cp .env.example .env
#   # 修改下面所有标了「必须修改」的项
#   docker compose up -d
#
# ⚠️ .env 已被 .gitignore 忽略，**不要**提交真实密码。
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=aicamera
# 【必须修改】数据库密码。生成一个随机密码：
#   openssl rand -base64 24        （或）  head -c 32 /dev/urandom | base64
POSTGRES_PASSWORD=
POSTGRES_DB=ai_camera_dev
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=aicamera_redis
REDIS_PORT=6379

# ── 应用端口 ────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8081

# ── 后端（profile: full）─────────────────────────────────────────────────────
# 【必须修改】JWT 签名密钥。生成：
#   openssl rand -base64 48
JWT_SECRET=

# ── v0.2.0 规划（profile: gb28181 / voice）──────────────────────────────────
# ZLMediaKit API 密钥。
# ★ 长度必须 ≥32 字符 —— ZLM 启动时会校验并自动改写过短的 secret（实测 19 字符被拒）
# ★ 三处必须一致：本变量、ac_gb_media_server.secret（seed 里同值）、ZLM [api] secret
#   （由 deploy/zlm/render-config.sh 渲染注入，不需要手改 config.ini）
ZLM_SECRET=aicamera-zlm-dev-secret-0123456789
# ZLM 回调平台的基址（ZLM 容器内访问 backend）。
#   compose full（默认）：backend 发布在宿主机 8081 → 保持默认
#   本地开发：backend 直接跑在宿主机 8080 → 改成 http://host.docker.internal:8080
ZLM_HOOK_BASE=http://host.docker.internal:8081
# SIP 监听地址与平台国标信息
SIP_IP=0.0.0.0
SIP_PORT=5060
SIP_DOMAIN=3402000000
SIP_PLATFORM_ID=34020000002000000001
# ★ 设备可达的本机地址（局域网 IP，如 192.168.1.50）。
#   它同时用于：SIP 报文的 Via/Contact、SDP 的 c=/o=（设备往哪里推流）。
#   填 127.0.0.1 只够本机模拟器联调；真机接入必须填局域网 IP。
SIP_ADVERTISE_IP=127.0.0.1
# 无状态 Digest nonce 的 HMAC 密钥。留空 = 开发模式固定串；
# 生产环境请注入随机值（openssl rand -hex 32）
SIP_NONCE_SECRET=
# 语音 Agent（profile: voice）控制面共享 token。
# 【必须修改】启用 pipecat 时必须设置，否则容器 fail-fast 拒绝启动。
#   openssl rand -hex 32
# ★ 与后台「语音 Agent 配置 → Pipecat 控制面令牌」必须完全一致；
#   backend 用 Authorization: Bearer <token> 下发配置。
PIPECAT_TOKEN=
# MQTT broker（profile: iot）与后端之间的 RPC 共享令牌。
# 【必须修改】启用 mqtt 服务时必须设置；broker 为空会拒绝启动，后端为空会拒绝所有鉴权。
#   openssl rand -hex 32
# ★ 两端必须是同一个值：broker 的 MQTT_RPC_TOKEN = 后端的 MQTT_RPC_TOKEN
MQTT_RPC_TOKEN=
# MQTT broker 访问后端的基址（容器内默认走 compose 服务名）
MQTT_BACKEND_RPC_URL=http://backend:8080

# ── TURN / STUN（profile: turn，coturn）────────────────────────────────────
# 与后端 TURN_STATIC_AUTH_SECRET 必须完全一致；coturn 用它验证后端签发的
# 短期凭据（username="<过期时间戳>:<subject>"，password=Base64(HMAC-SHA1)）。
# 【必须修改】openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=
TURN_REALM=ai-camera
# ★ 客户端可达的宿主机地址；NAT 后必须填公网/映射地址，否则中继地址不可用。
TURN_EXTERNAL_IP=127.0.0.1
# STUN/TURN 监听端口
TURN_PORT=3478
# 后端签发凭据的有效期（秒），默认 3600，服务端会夹在 60–86400
TURN_TTL_SECONDS=3600
# 后端 /rpc/turn/credentials 的共享令牌（调用方使用 X-RPC-Token）
#   openssl rand -hex 32
TURN_RPC_TOKEN=
# 返回给客户端的 ICE 服务器列表（逗号分隔）。
# ★ 必须填客户端可达的地址（与 TURN_EXTERNAL_IP 一致），不能写 compose 服务名
#   "turn" —— 手机/浏览器不在 compose 网络里，解析不到。
TURN_URLS=stun:127.0.0.1:3478,turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
# 语音 Agent 的 LLM 密钥（STT/TTS 默认走本地零密钥方案，见设计文档 §8.2）
# 注意：该变量只给独立调试用；正式配置走后台页面并存入 ac_thirdparty_config。
LLM_API_KEY=
