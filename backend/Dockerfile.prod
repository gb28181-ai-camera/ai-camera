# AI Camera 后端服务 - 生产环境镜像（仅交付二进制，配置由 ConfigMap 挂载）
# ── 构建阶段 ──
FROM golang:1.26-alpine AS builder

ENV GOPROXY=https://mirrors.aliyun.com/goproxy/,direct
ENV GOSUMDB=off

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV GOOS=linux
ENV CGO_ENABLED=0
ENV GOARCH=amd64
# 两个入口同一镜像：HTTP API 与 SIP 信令服务。
# 生产默认建议单容器内嵌（GB28181_EMBEDDED=true），
# 独立 sipsvc 只有在实现了跨进程命令通道后才有意义（见部署文档 §9.6）。
RUN go build -ldflags="-w -s" -o /app/ai-camera-api ./cmd/server/main.go && \
    go build -ldflags="-w -s" -o /app/ai-camera-sipsvc ./cmd/sipsvc/main.go

# ── 运行阶段 ──
FROM alpine:latest

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories && \
    apk add --no-cache ca-certificates tzdata wget

ENV TZ=Asia/Shanghai

WORKDIR /

COPY --from=builder /app/ai-camera-api .
COPY --from=builder /app/ai-camera-sipsvc .

# 8080 HTTP API；5060 SIP（内嵌模式下由同一进程监听）
EXPOSE 8080 5060/udp 5060/tcp

ENTRYPOINT ["/ai-camera-api"]
