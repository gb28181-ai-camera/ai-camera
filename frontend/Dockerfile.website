# AI Camera 官网介绍页 - 生产镜像
# 构建产物为 dist-website/（由 npm run build:website 产出，base 为 /）
# ── 构建阶段 ──
FROM node:24-alpine AS builder

# CI runner 走国内镜像源
RUN npm config set registry https://registry.npmmirror.com

WORKDIR /build

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build:website

# ── 运行阶段 ──
FROM nginx:alpine

COPY --from=builder /build/dist-website /usr/share/nginx/html
COPY nginx.website.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
