{
  "name": "ai-camera",
  "version": "0.1.0",
  "description": "AI Camera - AI 智能监控平台（管理后台 / 官网 / 桌面端）",
  "license": "Proprietary",
  "author": "AI Camera",
  "private": true,
  "main": ".vite/build/main.js",
  "build": {
    "appId": "com.aicamera.app",
    "productName": "AI Camera",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "packElevateHelper": false,
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:website": "vite --config vite.website.config.ts",
    "dev:desktop": "electron-forge start",
    "build": "npm run build:admin && npm run build:website",
    "build:admin": "tsc --noEmit && vite build",
    "build:website": "vite build --config vite.website.config.ts",
    "build:desktop": "electron-forge make",
    "package:desktop": "electron-forge package",
    "make:win": "electron-forge make --platform win32",
    "make:mac": "electron-forge make --platform darwin",
    "make:linux": "electron-forge make --platform linux",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "api:gen": "bash scripts/api-gen.sh"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.22.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.7.0",
    "@electron-forge/maker-deb": "^7.7.0",
    "@electron-forge/maker-dmg": "^7.7.0",
    "@electron-forge/maker-rpm": "^7.7.0",
    "@electron-forge/maker-zip": "^7.7.0",
    "@electron-forge/plugin-vite": "^7.7.0",
    "@felixrieseberg/electron-forge-maker-nsis": "^7.2.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "jsdom": "^29.1.1",
    "less": "^4.6.7",
    "msw": "^2.14.6",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
